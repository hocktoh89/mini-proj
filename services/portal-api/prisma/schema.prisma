generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Products and stock live in the ERP; these tables only record orders placed through the portal.
model Order {
  id         Int         @id @default(autoincrement())
  // ERP user id of whoever placed the order.
  userId     Int
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSku String
  quantity   Int

  @@index([orderId])
  @@map("order_items")
}
