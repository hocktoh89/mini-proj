// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  locked
}

model User {
  id            Int            @id @default(autoincrement())
  username      String?
  email         String         @unique
  password      String
  status        UserStatus     @default(active)
  lastLoginAt   DateTime?      @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz
  userRole      UserRole?
  createdAt     DateTime       @default(now()) @db.Timestamptz
  refreshTokens RefreshToken[]

  // Hierarchy access (catalog visibility). organizationId is null for staff users outside any tree.
  organizationId Int?
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  hierarchyNodes UserHierarchyNode[]
  overrides      UserOverride[]
  apiClient      ApiClient?

  @@index([organizationId])
  @@map("users")
}

// User Role Access Control Domain (17)
enum RoleStatus {
  active
  inactive
}

enum PermissionStatus {
  active
  inactive
}

enum PermissionType {
  menu
  action
  api
  report
  setting
}

enum PermissionRiskLevel {
  low
  medium
  high
  critical
}

model Role {
  id               BigInt            @id @default(autoincrement())
  code             String            @unique
  name             String
  description      String?
  level            Int
  isSystemRole     Boolean           @default(true)
  status           RoleStatus        @default(active)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  fieldPermissions FieldPermission[]

  @@map("roles")
}

model Permission {
  id              BigInt              @id @default(autoincrement())
  code            String              @unique
  name            String
  description     String
  category        String
  type            PermissionType
  riskLevel       PermissionRiskLevel
  isLocked        Boolean             @default(false)
  status          PermissionStatus    @default(active)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@map("permissions")
}

// One active role per user - enforced by the @unique on userId, not just app validation.
model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    BigInt
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("userRoles")
}

model RolePermission {
  id           BigInt     @id @default(autoincrement())
  roleId       BigInt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId BigInt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([roleId, permissionId])
  @@map("rolePermissions")
}

// One row per login session, id is the session's jti (also embedded in both the access and
// refresh JWT so a request/refresh can be checked against this exact session). Single session
// per user is enforced at the app layer (RefreshTokenService.createSession revokes any prior
// active row for the user before inserting a new one), not by a DB constraint - so this is a
// row-per-session table, not row-per-user. Login/logout/session-invalidation history lives in
// AuditEvent instead (userLoggedIn/userLoggedOut/userSessionsInvalidated/userSessionRevoked).
// Expired/revoked rows aren't purged yet - a future scp-worker cleanup job should do this once
// that process exists (see CLAUDE.md).
model RefreshToken {
  id                String    @id @default(uuid())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  replacedByTokenId String?

  @@index([userId])
  @@map("refreshTokens")
}

// Third-party API access. Each client is backed by a service-account User, so the client's role,
// hierarchy nodes and overrides are the same rows a human user would have. The raw key is shown
// once at creation; only its prefix (for lookup) and SHA-256 hash are stored.
enum ApiClientStatus {
  active
  suspended
  revoked
}

model ApiClient {
  id         Int             @id @default(autoincrement())
  name       String
  userId     Int             @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPrefix  String          @unique
  keyHash    String
  status     ApiClientStatus @default(active)
  // Empty = any IP.
  allowedIps String[]        @default([])
  expiresAt  DateTime?       @db.Timestamptz(3)
  lastUsedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  @@map("apiClients")
}

// Catalog access hierarchy (see requirementSchema/). Levels and nodes are rows, so each
// organization defines its own depth. Extra rules Prisma can't express (level_no >= 1, node level =
// parent level + 1, NULL-safe field rule uniqueness) live in the access_hierarchy migration.

enum OverrideEffect {
  ALLOW
  DENY
}

model Organization {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  users  User[]
  levels HierarchyLevel[]

  @@map("organizations")
}

model HierarchyLevel {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levelNo          Int // 1 = top
  name             String // Division, Country, Brand, ...
  nodes            HierarchyNode[]
  fieldPermissions FieldPermission[]

  @@unique([organizationId, levelNo])
  @@unique([organizationId, name])
  @@map("hierarchyLevels")
}

model HierarchyNode {
  id       Int                 @id @default(autoincrement())
  levelId  Int
  level    HierarchyLevel      @relation(fields: [levelId], references: [id])
  parentId Int? // null = top node
  parent   HierarchyNode?      @relation("NodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children HierarchyNode[]     @relation("NodeTree")
  name     String
  users    UserHierarchyNode[]
  tags     ResourceNodeTag[]
  blocks   NodeBlock[]

  @@index([levelId])
  @@index([parentId])
  @@map("hierarchyNodes")
}

model UserHierarchyNode {
  userId Int
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId Int
  node   HierarchyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
  @@map("userHierarchyNodes")
}

model Product {
  id           Int     @id @default(autoincrement())
  sku          String  @unique
  name         String
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("USD") @db.Char(3) // ISO 4217
  stockQty     Int     @default(0)
  // In stock (stockQty > 0). Kept in step by every stock write, as in the ERP this came from.
  availability Boolean @default(false)
  cost         Decimal @db.Decimal(12, 2)

  @@map("products")
}

// resourceType + resourceId point at any secured thing ('product', ...). resourceId has no FK
// because it is polymorphic.

// "This item is made available at this node" - visible to the node, its ancestors and descendants.
model ResourceNodeTag {
  id           Int           @id @default(autoincrement())
  resourceType String
  resourceId   Int
  nodeId       Int
  node         HierarchyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, nodeId])
  @@index([nodeId])
  @@index([resourceType, resourceId])
  @@map("resourceNodeTags")
}

// "This item cannot be seen through this node" - cuts any tag path that passes through it.
model NodeBlock {
  id           Int           @id @default(autoincrement())
  resourceType String
  resourceId   Int
  nodeId       Int
  node         HierarchyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  reason       String?

  @@unique([resourceType, resourceId, nodeId])
  @@index([nodeId])
  @@map("nodeBlocks")
}

// Per-user exceptions; beat the hierarchy, and DENY beats ALLOW.
model UserOverride {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   Int
  effect       OverrideEffect
  reason       String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime?      @db.Timestamptz(3)

  // One effect per user + item, so the two can never conflict.
  @@unique([userId, resourceType, resourceId])
  @@map("userOverrides")
}

// Column-level access. fieldName must match the resource model's field name.
model FieldDefinition {
  id             Int               @id @default(autoincrement())
  resourceType   String
  fieldName      String
  defaultVisible Boolean           @default(false) // fail-closed
  permissions    FieldPermission[]

  @@unique([resourceType, fieldName])
  @@map("fieldDefinitions")
}

// Targets a role and/or a level (at least one; both = must match both). allowed = false is a DENY.
model FieldPermission {
  id      Int             @id @default(autoincrement())
  fieldId Int
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  roleId  BigInt?
  role    Role?           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  levelId Int?
  level   HierarchyLevel? @relation(fields: [levelId], references: [id], onDelete: Cascade)
  allowed Boolean

  @@index([fieldId])
  @@map("fieldPermissions")
}
