DB_USER=dbAdmin
DB_PASSWORD=db2026!
DB_NAME=testDB

DATABASE_URL="postgresql://dbAdmin:db2026!@localhost:5431/testDB?schema=public"
CONTAINER_DATABASE_URL="postgresql://dbAdmin:db2026!@postgres:5432/testDB?schema=public"

# App
# NODE_ENV=development
NODE_ENV=production
PORT=3000

# BFF / CORS - origin of the frontend app allowed to send credentialed requests
# FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:4000,http://localhost:3000,http://localhost:5173
AUTH_COOKIE_SECURE=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=60m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=62m
JWT_SECRET=some-long-random-string

# Cookie names
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
